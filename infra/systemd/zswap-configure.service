[Unit]
Description=Configure zswap in-RAM compressed swap cache
After=systemd-modules-load.service
Before=basic.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo lz4 > /sys/module/zswap/parameters/compressor && echo 20 > /sys/module/zswap/parameters/max_pool_percent && echo 1 > /sys/module/zswap/parameters/enabled'

[Install]
WantedBy=basic.target
