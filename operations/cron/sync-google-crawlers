# Periodically sync official Google crawler IP ranges for HAProxy.
# Runs every Sunday at 04:00 UTC. Automatically updates /etc/haproxy and reloads HAProxy if changed.
0 4 * * 0 root node /var/www/bundlephobia/operations/haproxy/scripts/sync-google-crawlers.js --install --reload >> /var/log/haproxy-google-sync.log 2>&1
