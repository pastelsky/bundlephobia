# Periodically sync official Google crawler IP ranges for HAProxy.
# Runs daily at 04:00 UTC. Automatically updates /etc/haproxy/google-crawler-networks.lst and reloads HAProxy if changed.
0 4 * * * root node /var/www/bundlephobia/operations/haproxy/scripts/sync-google-crawlers.js --reload >> /var/log/haproxy-google-sync.log 2>&1
