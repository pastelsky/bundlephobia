[Unit]
Description=On-demand Bundlephobia stats gateway and VictoriaMetrics
After=network.target

[Service]
Type=simple
User=bundlephobia-stats
Group=bundlephobia-stats
WorkingDirectory=/var/www/bundlephobia
Environment=VICTORIAMETRICS_BIN=/usr/local/bin/victoria-metrics-prod
Environment=VICTORIAMETRICS_SCRAPE_CONFIG=/etc/bundlephobia-victoriametrics/promscrape.yml
Environment=VICTORIAMETRICS_STORAGE_PATH=/var/lib/bundlephobia-victoriametrics
Environment=VICTORIAMETRICS_LISTEN_ADDR=127.0.0.1:8428
Environment=VICTORIAMETRICS_RETENTION=30d
Environment=STATS_IDLE_TIMEOUT_MS=1800000
ExecStart=/usr/bin/node /var/www/bundlephobia/operations/victoriametrics/stats-gateway.mjs
Restart=no
KillMode=control-group
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bundlephobia-victoriametrics
MemoryMax=384M
CPUWeight=10

[Install]
