{
  "title": "Traffic and sessions",
  "rows": [
    {
      "panels": [
        {
          "title": "Inbound bytes per second",
          "width": 12,
          "unit": "bytes/second",
          "expr": ["sum by (proxy) (rate(haproxy_frontend_bytes_in_total[5m]))"],
          "alias": ["{{proxy}}"]
        },
        {
          "title": "Outbound bytes per second",
          "width": 12,
          "unit": "bytes/second",
          "expr": ["sum by (proxy) (rate(haproxy_frontend_bytes_out_total[5m]))"],
          "alias": ["{{proxy}}"]
        },
        {
          "title": "Current sessions",
          "width": 12,
          "unit": "sessions",
          "expr": ["sum by (proxy) (haproxy_frontend_current_sessions)"],
          "alias": ["{{proxy}}"]
        }
      ]
    }
  ]
}
