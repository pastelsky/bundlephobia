{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "jsx-a11y", "nextjs", "react", "jest"],
  "rules": {
    "no-unused-vars": "error",
    "no-shadow": "error",
    "eqeqeq": "error",
    "no-negated-condition": "error",
    "preserve-caught-error": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "jest": true
  },
  "settings": {
    "react": {
      "version": "19.2.8"
    },
    "next": {
      "rootDir": "."
    },
    "jest": {
      "version": 30
    }
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "playwright-report/**",
    "test-results/**",
    "test-packages/**",
    "next-env.d.ts"
  ]
}
